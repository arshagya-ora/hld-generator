# Local development example. Copy to backend/.env and replace the placeholders.
# Never commit a populated .env file.

ENVIRONMENT=development
DEBUG=false
HOST=127.0.0.1
PORT=6602

# SQLite is suitable for local development. Choose and configure a database
# separately for deployment.
DATABASE_URL=sqlite+aiosqlite:///./hld_generator.db

REDIS_URL=redis://localhost:6379
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3

# Generate unique values for each installation:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
JWT_SECRET_KEY=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME

MAX_UPLOAD_SIZE_MB=20
MAX_UPLOAD_FILES=10
CORS_ORIGINS=["http://localhost:6601"]

# Configure an OCI profile locally. Use OCI identifiers from your own account.
OCI_PROFILE=CONFIG
OCI_CONFIG_FILE=~/.oci/config
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..your-compartment-id
OCI_BASE_URL=https://your-model-endpoint.example
OCI_GENAI_MODEL_ID=ocid1.generativeaimodel.oc1.region.your-model-id

# Relative paths are resolved against backend/.
STORAGE_PATH=./storage
IMAGE_STORAGE_DIR=./images
OUTPUT_DIR=./outputs
RAG_WORKING_DIR=../rag_storage
PRODUCT_PROFILE_DIR=product_profiles
