    {
      "dot": "cyan",
      "title": "Primary request",
      "items": [
        "Browser uploads source documents and creates a job through the authenticated API",
        "The API enqueues work; the worker runs the HLD pipeline",
        "The finished document is stored and served by the API"
      ]
    },
    {
      "dot": "violet",
      "title": "Inside the pipeline",
      "items": [
        "Document analysis → profile-guided blueprint → retrieval → content generation → assembly",
        "Private profile JSON guides structure; retrieval indexes provide optional reference material"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "User traffic crosses into the application at the API",
        "The pipeline crosses to an external model endpoint",
        "Uploaded documents are encrypted in local storage; database and Redis hold runtime state"
      ]
    }
